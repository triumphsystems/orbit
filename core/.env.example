# ==============================================================================
# Orbit — Canonical Environment Configuration Template
# All settings follow Orbit's Provider-Agnostic Design Standards (AGENTS.md)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform & Server Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Master encryption key for vault secret masking & AES-128 credential storage
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ORBIT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# Comma-separated list of allowed web origins for CORS (e.g. https://app.orbit.dev,https://dashboard.orbit.dev)
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 2. LLM Engine (Provider-Agnostic)
# Provider discriminator: LLM_PROVIDER (gemini | openrouter | openai)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.5-flash
# Base URL is only required when using OpenAI / OpenRouter / local LLM gateways:
LLM_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 3. Web Data Retrieval & Search Engine Discovery (Provider-Agnostic)
# ------------------------------------------------------------------------------
RETRIEVAL_API_KEY=your-proxy-unlocker-api-key
RETRIEVAL_ZONE=your_unlocker_zone_name
RETRIEVAL_BASE_URL=https://api.brightdata.com

SEARCH_ENGINE_API_KEY=your-search-engine-api-key
SEARCH_ENGINE_BASE_URL=https://serpapi.com/search.json

# ------------------------------------------------------------------------------
# 4. Database Persistence Store
# PostgreSQL (Production / Docker) or SQLite (Local file / Testing)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://orbit:orbit@localhost:5432/orbit
# For local SQLite fallback:
# DATABASE_URL=sqlite:///./orbit.db

# ------------------------------------------------------------------------------
# 5. Production Message Broker, Distributed Lock & Task Queue (orb: Key Prefix)
# Options for EVENT_BROKER_BACKEND: "memory" (default/local) | "redis" | "pubsub"
# ------------------------------------------------------------------------------
EVENT_BROKER_BACKEND=memory

# Broker connection URL (Redis / Cloud Memorystore / Upstash)
BROKER_URL=redis://localhost:6379/0

# Cloud Project ID (used when EVENT_BROKER_BACKEND=pubsub)
BROKER_PROJECT_ID=

# Global key prefix for all Redis streams, distributed locks, rate limiters, and queues
BROKER_KEY_PREFIX=orb

# ------------------------------------------------------------------------------
# 6. Unified Cache Storage
# Options for CACHE_BACKEND:
#   - "memory" (default): Fast in-process LRU cache for local dev / single container
#   - "redis"           : High-throughput distributed cache for multi-worker / cluster setups
# ------------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_BACKEND=memory
# Connection URL for distributed Redis cache (required only if CACHE_BACKEND=redis)
CACHE_URL=redis://localhost:6379/1
# Default Time-To-Live in seconds for cached reports, probes, and query plans
CACHE_DEFAULT_TTL=300

# ------------------------------------------------------------------------------
# 7. API Endpoint Rate Limiting
# Token bucket / sliding window rate limits per minute
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GOAL_PER_MINUTE=10
RATE_LIMIT_RUN_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 8. Cloud Object Storage (Provider-Agnostic: GCS / S3 / Local)
# ------------------------------------------------------------------------------
# Storage backend: "local" (default exports/ directory) | "gcs" (Google Cloud Storage) | "s3"
STORAGE_BACKEND=local
STORAGE_BUCKET_NAME=orbit-exports
STORAGE_REGION=us-central1
# For GCS Workload Identity or S3/MinIO:
STORAGE_PROJECT_ID=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# 9. Scheduler & Cloud Webhook Execution
# Set ENABLE_SCHEDULER=true for local in-process daemon
# Set ENABLE_SCHEDULER=false for stateless serverless containers (Cloud Run / Lambda)
# ------------------------------------------------------------------------------
ENABLE_SCHEDULER=true
SCHEDULER_SECRET=your-secure-scheduler-webhook-secret-token

# ------------------------------------------------------------------------------
# 9. Document Processing Services (Provider-Agnostic Managed Adapters)
# ------------------------------------------------------------------------------
# Inbound format normalization & OCR engine (e.g. Foxit)
DOCUMENT_CONVERTER_API_KEY=
DOCUMENT_CONVERTER_BASE_URL=https://api.foxit.com/v1

# Outbound HTML-to-PDF dossier generation engine (e.g. Nutrient)
DOCUMENT_DOSSIER_API_KEY=
DOCUMENT_DOSSIER_BASE_URL=https://api.nutrient.io

# Automated PII masking & compliance redactor (e.g. Nutrient)
DOCUMENT_REDACTOR_API_KEY=
DOCUMENT_REDACTOR_BASE_URL=https://api.nutrient.io

# Enterprise template merging & e-signature engine (e.g. Doctavian)
DOCUMENT_TEMPLATE_API_KEY=
DOCUMENT_TEMPLATE_BASE_URL=https://api.doctavian.com/v1

# ------------------------------------------------------------------------------
# 10. Outbound Email Delivery (Provider-Agnostic Managed Outbound Gateway)
# ------------------------------------------------------------------------------
EMAIL_API_KEY=
EMAIL_SENDER_ADDRESS="Orbit Alerts <alerts@orbit.dev>"
EMAIL_BASE_URL=https://api.orbit.dev/v1/emails
